{
    "name": "loveduckie/silverstripe-image-uploader-api",
    "description": "A Silverstripe module for exposing an API for enabling remote image uploads.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "version":"1.0.0",
    "authors": [
    {
      "name": "Luc Shelton","email": "lucshelton@gmail.com",
        "homepage": "https://www.lucshelton.com",
        "role": "Developer"
    }
    ],
    "support": {
        "email": "lucshelton@gmail.com",
        "issues": "https://github.com/loveduckie/silverstripe-image-uploader-api/issues"
    },
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^5.0",
        "silverstripe/admin": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7",
        "squizlabs/php_codesniffer": "^3.0",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "LoveDuckie\\Silverstripe\\ImageUploaderApi\\": "src/",
            "LoveDuckie\\Silverstripe\\ImageUploaderApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "installer-name": "silverstripe-image-uploader-api",
        "screenshots": [],
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
